@startuml

left to right direction

actor "HR Advisor" as HR
actor "Department Manager" as Manager

rectangle Database

rectangle "HR System" {
    usecase UC1 as "Produce salary report
    for all employees"

    usecase UC2 as "Produce salary report
    for a department"

    usecase UC3 as "Produce salary report
    for manager's department"

    usecase UC4 as "Get salaries
    by role"

    usecase UC5 as "Add a new
    employee"

    usecase UC6 as "View an employee
    record"

    usecase UC7 as "Update an employee
    record"

    usecase UC8 as "Delete an employee
    record"

    usecase UCa as "Print salaries"

    HR - UC1
    HR - UC2
    HR - UC4
    HR - UC5
    HR - UC6
    HR - UC7
    HR - UC8

    Manager - UC3

    UC1 - Database
    UC2 - Database
    UC3 - Database
    UC4 - Database
    UC5 - Database
    UC6 - Database
    UC7 - Database
    UC8 - Database

    UC4 ..> UCa : include
}

@enduml